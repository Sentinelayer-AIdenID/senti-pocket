<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by both UserNotifications and PushKit. The build configuration supplies development/production. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Universal links: iOS hands sentinelayer.com room links to the app only once both domains serve
	     /.well-known/apple-app-site-association naming this app (Team ID + com.plexaura.sentipocket.app). Today both
	     answer that path with the web app's HTML, so links from Mail or Messages open in the browser; links inside
	     the app are routed in-app either way. SentiLink decides what opens in-app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sentinelayer.com</string>
		<string>applinks:www.sentinelayer.com</string>
	</array>
</dict>
</plist>
