<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by both UserNotifications and PushKit. The build configuration supplies development/production. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Universal links: sentinelayer.com room links open the room in the app. The site's
	     /.well-known/apple-app-site-association names this app; SentiLink decides what opens in-app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sentinelayer.com</string>
		<string>applinks:www.sentinelayer.com</string>
	</array>
</dict>
</plist>
